った内容を復習として載せるかもしれません．","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"hrh9Ey4hS1"}],"key":"VWZi0jhvf9"},{"type":"heading","depth":2,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"経済学者から見る因果推論","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"itsN1uTZn5"}],"identifier":"id","label":"経済学者から見る因果推論","html_id":"id-2","implicit":true,"key":"ClB0IxrK6m"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"今年度のマクロデータサイエンスでは，昨年度の潜在結果モデルの内容に付け加えて，経済モデルから構造方程式を導出する伝統的な因果推論の手法や，Judea Pearl のSCM（Structural Causal Model）への導入などかなりリッチな授業でした．まだ受講中ですが．","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"DGnAFctGgt"}],"key":"GpWTDJzFKF"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"インターン先でちょうど SCM について学習を進めていたので，ホクホクです．それにしても先生の説明がわかりやすくて脱帽です．心理学の世界にはファインマン効果と呼ばれるものがあるらしいですが，ファインマンもきっとこういう授業をしていたんだろうなと思ったりするほどです．","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"cc8kOfIbmS"}],"key":"Dtr4RWJj5o"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"以上．","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"J8xO1xUcG7"}],"key":"bgXDiAOpUT"}],"key":"uJsYPQ9Cbe"}],"key":"eJYYsGAjaq"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Blogs","url":"/blogs","group":"Welcome"},"next":{"title":"Notion から Myst へ部分的に移行する","url":"/blog/2025/notion-to-myst","group":"2025"}}},"domain":"http://localhost:3000"}